{
  "name": "@mapmory/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "render": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "parity": "tsx --env-file-if-exists=../../.env test/parity.ts",
    "bench": "tsx --env-file-if-exists=../../.env test/bench.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@maplibre/maplibre-gl-native": "^6.4.1",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@sentry/node": "^11.8.0",
    "bullmq": "^6.4.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@mapmory/db": "workspace:*",
    "@mapmory/design-schema": "workspace:*",
    "@mapmory/poster-core": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
