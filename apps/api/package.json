{
  "name": "@mapmory/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "evals": "tsx --env-file-if-exists=../../.env evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@sentry/node": "^11.8.0",
    "altcha-lib": "^2.7.0",
    "better-auth": "^1.7.12",
    "bullmq": "^6.4.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mapmory/db": "workspace:*",
    "@mapmory/design-schema": "workspace:*",
    "@mapmory/fonts": "workspace:*",
    "@mapmory/poster-core": "workspace:*",
    "@mapmory/themes": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.2.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
