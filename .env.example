# Copy to .env and replace the secrets: `openssl rand -base64 48` (APP_SECRET, BETTER_AUTH_SECRET), `openssl rand -base64 32` (DATA_ENCRYPTION_KEY).
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:5173

DATABASE_URL=postgres://mapmory_app:mapmory_app_dev_password@localhost:5434/mapmory
MIGRATION_DATABASE_URL=postgres://mapmory:mapmory_dev_password@localhost:5434/mapmory
RENDERER_DATABASE_URL=postgres://mapmory_renderer:mapmory_renderer_dev_password@localhost:5434/mapmory
REDIS_URL=redis://localhost:6380

APP_SECRET=change-me-generate-with-openssl-rand-base64-48
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-48
DATA_ENCRYPTION_KEY=change-me-openssl-rand-base64-32

SMTP_URL=smtp://localhost:1025
MAIL_FROM=Mapmory <no-reply@mapmory.local>

S3_ENDPOINT=http://localhost:8333
# S3_PUBLIC_ENDPOINT=https://downloads.example.com   # when browsers reach storage on a different host
S3_REGION=eu-central-1
S3_BUCKET=mapmory-exports
S3_ACCESS_KEY_ID=mapmory
S3_SECRET_ACCESS_KEY=mapmory_dev_password
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true

TILES_PUBLIC_URL=http://localhost:3010
TILES_INTERNAL_URL=http://localhost:3010

# photon (public instance, fair use, dev only) | nominatim | stub (offline, dev regions only)
GEOCODER=stub
GEOCODER_URL=https://photon.komoot.io

# anthropic (needs ANTHROPIC_API_KEY) | openai-compatible (e.g. local Ollama) | heuristic (no LLM)
LLM_PROVIDER=heuristic
# ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_MODEL=qwen2:7b

ALTCHA_ENABLED=true
RENDER_CMYK_ENABLED=false
LOG_LEVEL=info

# Optional: GlitchTip/Sentry DSN for error tracking (PII is stripped before sending)
# SENTRY_DSN=
